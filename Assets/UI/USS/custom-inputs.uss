.custom-input {
  background-color: var(--white);
  border-width: 1px;
  margin-left: 0;
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
  min-height: 60px;
  min-width: 60px;
}

.custom-input > .unity-base-field__input {
  background-color: transparent;
  border-width: 0;
  margin-left: 0;
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
}
