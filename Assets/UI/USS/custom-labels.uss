.custom-label.use-default-font-color {
    color: var(--white);
}

.unity-label {
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}

.x-small-font {
    font-size: 6px;
}

.small-font {
    font-size: 12px;
}

.regular-font {
    font-size: 16px;
}

.medium-large-font {
    font-size: 20px;
}

.large-font {
    font-size: 24px;
}

.x-large-font {
    font-size: 36px;
}
