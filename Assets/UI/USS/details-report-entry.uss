.details-report-main {
    flex-direction: column;
    border-bottom-width: 1px;
    height: 100%;
}

.time-range-labels-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 100%;
}

.time-range-label {
}

.time-range-label-container {
}

.option-buttons-container {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
    min-width: 25%;
    max-width: 25%;
}

.option-button-container {
    height: 100%;
    min-width: 33%;
    padding-right: 1.5%;
    padding-left: 1.5%;
}

.option-button {
    justify-content: center;
    align-items: center;
}

.report-details-container {
    flex-direction: row;
    min-height: 75px;
}

.job-details-container {
    padding-left: 6%;
}
