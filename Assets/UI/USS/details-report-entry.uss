.details-report-main {
    flex-direction: column;
    border-bottom-width: 1px;
    height: 100%;
}

.time-range-labels-container {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    align-content: center;
    flex-grow: 1;
    min-height: 40px;
    width: 100%;
}

.time-range-label {
    overflow: hidden;
    text-overflow: ellipsis;
}

.time-range-label-container {
}

.option-buttons-container {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
    min-width: 180px;
    min-height: 60px;
    width: 100%;
}

.option-button-container {
    height: 100%;
    min-width: 50px;
    margin-right: 5px;
    margin-left: 5px;
}

.option-button {
    justify-content: center;
    align-items: center;
}

.report-details-container {
    flex-direction: row;
    min-height: 75px;
    padding-left: 35px;
}

.job-details-container {
    padding-left: 35px;
}
