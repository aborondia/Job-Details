.details-report-main {
    flex-direction: column;
    border-bottom-width: 1px;
    height: 100%;
}

.time-range-labels-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding-left: 5%;
}

.time-range-label {
}

.time-range-label-container {
}

.option-buttons-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.option-button-container {
    height: 100%;
    min-width: 60px;
    margin-left: 10px;
}

.option-button {
    justify-content: center;
    align-items: center;
}

.report-details-container {
    flex-direction: row;
    min-height: 60px;
}

.job-details-container {
    padding-left: 5%;
}
