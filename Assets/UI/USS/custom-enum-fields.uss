.custom-enum-field {
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}

.custom-enum-field > VisualElement {
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
}

.custom-enum-field > VisualElement > TextElement {
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

.custom-enum-field > VisualElement > VisualElement {
    display: none;
}
