.cleaner-row-main {
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: space-between;
}

.name-label-container {
    justify-content: center;
    overflow: hidden;
    height: 100%;
    flex-grow: 1;
}

.hours-input-container {
    flex-direction: row;
    min-width: 10%;
    max-width: 24%;
}

.name-label {
    white-space: normal;
    text-overflow: ellipsis;
    overflow: hidden;
    height: 100%;
    -unity-text-align: middle-left;
}

.name-selection-container {
    flex-grow: 1;
    justify-content: center;
    flex-direction: row;
}

.cleaners-scrollview {
    position: absolute;
    width: 100%;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    top: 0;
    margin-top: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    max-height: 400%;
}

.select-cleaner-button-container {
    min-width: 60px;
    max-width: 60px;
}

.select-cleaner-button {
    align-items: center;
    justify-content: center;
}

.select-cleaner-button-icon-container {
}

.hours-dropdown-field {
    margin-right: 5px;
    margin-left: 5px;
    min-width: 50px;
    height: 100%;
}

.custom-input > .unity-base-text-field__input > .unity-text-element {
    -unity-text-align: middle-center;
}
