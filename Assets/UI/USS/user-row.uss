.user-row-button-container {
    height: 100%;
    min-width: 7.5%;
}

.user-row-button {
    align-items: center;
    justify-content: center;
    flex-direction: row;
}

.user-row-button-label-container {
    height: 100%;
    justify-content: center;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.user-row-button-label {
}

.user-row-button-icon-container {
}

.user-row-button-icon {
    width: 20%;
}

.user-type-container {
    height: 100%;
    justify-content: center;
    width: 20%;
    min-width: 20%;
}

.user-role-label-container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.verify-user-button-container {
    height: 100%;
    width: 20%;
}

.user-type-container > DropdownField {
    height: 100%;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}
