.user-row-button-container {
    height: 100%;
    min-width: 60px;
}

.user-row-button {
    align-items: center;
    justify-content: center;
    flex-direction: row;
}

.user-row-button-label-container {
    height: 100%;
    justify-content: center;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.user-row-button-label {
}

.user-row-button-icon-container {
}

.user-row-button-icon {
    width: 20%;
}

.user-type-container {
    height: 100%;
    justify-content: center;
    min-width: 125px;
    width: 20%;
}

.user-role-label-container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.verify-user-button-container {
    height: 100%;
    width: 20%;
}

.user-type-container > DropdownField {
    height: 100%;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

DropdownField > VisualElement {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

DropdownField > VisualElement > PopupTextElement {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-text-align: middle-center;
    white-space: normal;
    text-overflow: ellipsis;
    overflow: hidden;
}
