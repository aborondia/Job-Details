.navigation-buttons-main {
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.navigation-button-container {
    min-height: 75px;
    align-items: center;
    max-width: 225px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    max-height: 75px;
    width: 50%;
}

.navigation-button {
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}
