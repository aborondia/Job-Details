.navigation-buttons-main {
  width: 100%;
  height: 100%;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.navigation-button-container {
  margin-top: 20px;
  margin-bottom: 20px;
  padding-top: 2px;
  padding-right: 4px;
  padding-bottom: 2px;
  padding-left: 4px;
  width: 50%;
  min-height: 100px;
  align-items: center;
  min-width: 40%;
  max-width: 40%;
}

.navigation-button {
  align-items: center;
  justify-content: center;
  padding-top: 10px;
  padding-right: 10px;
  padding-bottom: 10px;
  padding-left: 10px;
  width: 100%;
}
