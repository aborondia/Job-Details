.dropdown-field {
  margin: 0;
  width: 100%;
  height: 100%;
}

.dropdown-field > Label {
  min-width: auto;
  -unity-text-align: middle-center;
  padding-top: 5px;
  padding-right: 5px;
  padding-bottom: 5px;
  padding-left: 5px;
  color: var(--white);
}

.dropdown-field > VisualElement {
  margin: 0;
  padding: 0;
}

.dropdown-field > VisualElement > PopupTextElement {
  margin: 0;
  -unity-text-align: middle-center;
}
