.job-details-main {
    min-height: 60px;
    flex-direction: row;
}

.info-labels-container {
    flex-direction: row;
    flex-grow: 1;
    justify-content: flex-start;
    flex-wrap: wrap;
}

.multi-labels-container {
    flex-grow: 1;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    justify-content: space-between;
}

.info-label-container {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.info-label {
}

.job-option-buttons-container {
    flex-direction: row;
    min-width: 120px;
    justify-content: flex-end;
    height: 100%;
}

.option-button {
    align-items: center;
    justify-content: center;
}

.left-labels-container {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    justify-content: space-between;
}

.right-labels-container {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    justify-content: space-between;
}

.client-info-label {
    text-overflow: ellipsis;
}
