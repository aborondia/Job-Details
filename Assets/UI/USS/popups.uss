.popups-main {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.popup-parent {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    flex-direction: column-reverse;
    background-color: var(--gray4);
}

.popup-top {
    flex-grow: 1;
    width: 100%;
}

.popup-bottom {
    width: 100%;
    min-height: 60px;
}

.popup-buttons-container {
    width: 100%;
    height: 100%;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-direction: row;
    justify-content: space-between;
}

.popup-button-container {
    width: 40%;
    height: 100%;
}

.popup-button {
}

.popup-button-label-container {
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.display-message-label {
    white-space: normal;
    -unity-text-align: middle-center;
}

.recipient-scrollview {
    position: absolute;
    min-height: 400%;
    width: 100%;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    top: 0;
    margin-top: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    max-height: 400%;
}

.confirmation-popup-display-message-container {
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.send-email-content-input-container {
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.send-email-header-label-container {
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
}

.send-email-body-input-container {
    flex-grow: 1;
    width: 100%;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.sen-email-body-input {
    width: 100%;
    height: 100%;
}

.recipient-scrollview-container {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    min-height: 60px;
    margin-bottom: 5px;
}

.send-email-popup {
    min-width: 70%;
    min-height: 40%;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.notification-popup {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    min-width: 40%;
    min-height: 40%;
}

.confirmation-popup {
    min-width: 40%;
    min-height: 40%;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}
