.root-body {
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
}

.views-container {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
}

.main-views {
    height: 100%;
    flex-grow: 1;
    width: 100%;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.app-left-bar {
    height: 100%;
    min-width: 75px;
}

.app-right-bar {
    min-width: 75px;
    height: 100%;
}

.app-footer {
    width: 100%;
    min-height: 10%;
}

.main-view {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.interaction-blocker {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.02);
}

.app-header {
    min-height: 10%;
    width: 100%;
}

.icon-container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}
