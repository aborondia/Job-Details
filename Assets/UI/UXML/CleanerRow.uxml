<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/cleaner-row.uss?fileID=7433441132597879392&amp;guid=eea161ef31f384b429cf62eff7b533f1&amp;type=3#cleaner-row" />
    <Style src="project://database/Assets/UI/USS/name-select-dropdown.uss?fileID=7433441132597879392&amp;guid=789727474196e7f4197c7d4ce0b0cb69&amp;type=3#name-select-dropdown" />
    <CustomVisualElement name="main" class="cleaner-row-main">
        <CustomVisualElement name="delete-button-container" style="min-width: 15%;">
            <CustomButton use-background-color="false" use-border="false">
                <CustomVisualElement name="icon-container" class="icon-container" style="width: 100%; height: 100%; justify-content: center; align-items: center;">
                    <CustomVisualElement name="icon" regenerate-in-editor="true" enforce-largest-dimension="true" largest-dimension="30" class="gi-recycle-bin red1-img" />
                </CustomVisualElement>
            </CustomButton>
        </CustomVisualElement>
        <CustomVisualElement name="name-selection-container" class="name-selection-container">
            <CustomVisualElement name="name-label-container" class="name-label-container">
                <CustomLabel text="Cleaner Name" class="regular-font name-label" />
                <CustomVisualElement name="select-cleaner-button-container" class="select-cleaner-button-container" style="position: absolute; align-self: flex-end;">
                    <CustomButton use-border="false" use-background-color="false" class="select-cleaner-button">
                        <CustomVisualElement name="icon-container" class="icon-container select-cleaner-button-icon-container">
                            <CustomVisualElement name="icon" largest-dimension="30" enforce-largest-dimension="true" regenerate-in-editor="true" class="gi-edit" />
                        </CustomVisualElement>
                    </CustomButton>
                </CustomVisualElement>
            </CustomVisualElement>
            <ui:ScrollView class="custom-scrollbar white-bg gray1-border cleaners-scrollview name-select-dropdown regular-font" style="display: none;">
                <CustomLabel text="Cleaner Name" use-default-font-color="false" class="username-selection-entry" />
            </ui:ScrollView>
        </CustomVisualElement>
        <CustomVisualElement name="hours-input-container" class="hours-input-container">
            <CustomInput placeholder-text="Hours" keyboard-type="NumberPad" class="regular-font" />
        </CustomVisualElement>
    </CustomVisualElement>
</ui:UXML>
